  sequence:
  - character: 0
    speakerSprite: {fileID: -2069185945796123168, guid: 337ce6c3564cc8a4fb044661efac34b3, type: 3}
    speakerName: Cherry
    content:
    - Let's see... Our client's name is Anna... And...
    - She wants us to retrieve her Warding Rune from the end of the dungeon.
    - Looks easy enough! The three of us shall take on this quest!
    waitTime: 0.05
    textSpeed: 0.05
    isRight: 0
    isSpriteShowing: 1
    canSkip: 1
    autoNext: 0
  - character: 23
    speakerSprite: {fileID: 792778199420499268, guid: b96f669342d0f4c4e9ef15c78ce4df9d, type: 3}
    speakerName: Fern
    content:
    - Huh... My first quest...
    waitTime: 0.05
    textSpeed: 0.05
    isRight: 1
    isSpriteShowing: 1
    canSkip: 1
    autoNext: 0
  - character: 1
    speakerSprite: {fileID: -2733444605593320565, guid: dc0969557c4cf8f40bb757f8cb06197d, type: 3}
    speakerName: Damson
    content:
    - Don't worry, Fern. We've all been through that dungeon before.
    waitTime: 0.05
    textSpeed: 0.05
    isRight: 0
    isSpriteShowing: 1
    canSkip: 1
    autoNext: 0
  - character: 0
    speakerSprite: {fileID: -2069185945796123168, guid: 337ce6c3564cc8a4fb044661efac34b3, type: 3}
    speakerName: Cherry
    content:
    - yeah thats where you ran to after you robbed me
    waitTime: 0.05
    textSpeed: 0.05
    isRight: 0
    isSpriteShowing: 1
    canSkip: 1
    autoNext: 0
  - character: 1
    speakerSprite: {fileID: -2733444605593320565, guid: dc0969557c4cf8f40bb757f8cb06197d, type: 3}
    speakerName: Damson
    content:
    - Will you give that up!?
    - Anyway, we'll make sure your first quest goes swimmingly.
    waitTime: 0.05
    textSpeed: 0.05
    isRight: 0
    isSpriteShowing: 1
    canSkip: 1
    autoNext: 0
  - character: 23
    speakerSprite: {fileID: 792778199420499268, guid: b96f669342d0f4c4e9ef15c78ce4df9d, type: 3}
    speakerName: Fern
    content:
    - Thanks, guys. I won't disappoint you two.
    waitTime: 0.05
    textSpeed: 0.05
    isRight: 1
    isSpriteShowing: 1
    canSkip: 1
    autoNext: 0
  - character: 0
    speakerSprite: {fileID: -2069185945796123168, guid: 337ce6c3564cc8a4fb044661efac34b3, type: 3}
    speakerName: Cherry
    content:
    - Alright! Let's get ready!
    - We'll meet up at the dungeon entrance before we embark!
    waitTime: 0.05
    textSpeed: 0.05
    isRight: 0
    isSpriteShowing: 1
    canSkip: 1
    autoNext: 0
  - character: 1
    speakerSprite: {fileID: -2733444605593320565, guid: dc0969557c4cf8f40bb757f8cb06197d, type: 3}
    speakerName: Damson
    content:
    - Alright, we heard you.
    waitTime: 0.05
